<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GK6X</RootNamespace>
    <AssemblyName>GK6X</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0649;CS0414;CS0169;SYSLIB0014;CS8632</NoWarn>
    <OutputPath>..\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="HidSharp">
      <HintPath>HIDSharp\netstandard2.0\HidSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BitHelper.cs" />
    <Compile Include="CMFile.cs" />
    <Compile Include="CommandLogger.cs" />
    <Compile Include="Cli.cs" />
    <Compile Include="Config.cs" />
    <Compile Include="Crc16.cs" />
    <Compile Include="Daemon.cs" />
    <Compile Include="Enums.cs" />
    <Compile Include="KeyboardDevice.cs" />
    <Compile Include="KeyboardDeviceManager.cs" />
    <Compile Include="KeyboardState.cs" />
    <Compile Include="KeyValues.cs" />
    <Compile Include="Localization.cs" />
    <Compile Include="MiniJSON.cs" />
    <Compile Include="OpCodes.cs" />
    <Compile Include="Packet.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Realtime.cs" />
    <Compile Include="UserDataFile.cs" />
  </ItemGroup>

</Project>
